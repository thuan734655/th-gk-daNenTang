    "express": "^5.0.0",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
  }
