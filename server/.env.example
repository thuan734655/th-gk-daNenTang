PORT=3001
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
# Use literal \n between private-key lines.
FIREBASE_PRIVATE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional external ID of the manual collection for product images.
CLOUDINARY_PRODUCT_COLLECTION_ID=
# Set a long random value before implementing authentication.
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
# Generated by npm run setup:admin; never store an admin plaintext password here.
ADMIN_PASSWORD_HASH=
